// docs.getcalsync.app: the static docs in docs-site/, a Worker with static assets like the main site.
// Deploy from the repo root with `npx wrangler deploy -c wrangler.docs.jsonc`.
{
  "name": "getcalsync-docs",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./docs-site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "docs.getcalsync.app", "custom_domain": true }
  ],
  "workers_dev": false
}
