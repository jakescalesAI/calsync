{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CalSync",
  "mainBinaryName": "CalSync",
  "version": "0.1.0",
  "identifier": "app.getcalsync.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CalSync",
    "copyright": "MIT License",
    "category": "Productivity",
    "shortDescription": "CalSync",
    "longDescription": "Keep your Google, Outlook and iCloud calendars showing the same events. Runs on your own computer.",
    "homepage": "https://getcalsync.app",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../engine-dist/calsync-engine/": "engine/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
